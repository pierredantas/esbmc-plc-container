// IEC 61131-3 standard edge-detection and counter function blocks, transcribed for PLCverif, whose S7-300
// built-in library has no R_TRIG, F_TRIG, CTU, or CTD. Counters count up to PVmax/down to PVmin of INT, as the
// standard specifies; MATIEC instead stops CTU at PV, which changes CV above PV but never Q.

FUNCTION_BLOCK R_TRIG
VAR_INPUT
    CLK : BOOL;
END_VAR
VAR_OUTPUT
    Q : BOOL;
END_VAR
VAR
    M : BOOL := FALSE;
END_VAR
BEGIN
    Q := CLK AND NOT M;
    M := CLK;
END_FUNCTION_BLOCK

FUNCTION_BLOCK F_TRIG
VAR_INPUT
    CLK : BOOL;
END_VAR
VAR_OUTPUT
    Q : BOOL;
END_VAR
VAR
    M : BOOL := FALSE;
END_VAR
BEGIN
    Q := NOT CLK AND NOT M;
    M := NOT CLK;
END_FUNCTION_BLOCK

FUNCTION_BLOCK CTU
VAR_INPUT
    CU : BOOL;
    R : BOOL;
    PV : INT;
END_VAR
VAR_OUTPUT
    Q : BOOL;
    CV : INT;
END_VAR
VAR
    CU_T : R_TRIG;
END_VAR
BEGIN
    CU_T(CLK := CU);
    IF R THEN
        CV := 0;
    ELSIF CU_T.Q AND (CV < 32767) THEN
        CV := CV + 1;
    END_IF;
    Q := (CV >= PV);
END_FUNCTION_BLOCK

FUNCTION_BLOCK CTD
VAR_INPUT
    CD : BOOL;
    LD : BOOL;
    PV : INT;
END_VAR
VAR_OUTPUT
    Q : BOOL;
    CV : INT;
END_VAR
VAR
    CD_T : R_TRIG;
END_VAR
BEGIN
    CD_T(CLK := CD);
    IF LD THEN
        CV := PV;
    ELSIF CD_T.Q AND (CV > (-32767 - 1)) THEN
        CV := CV - 1;
    END_IF;
    Q := (CV <= 0);
END_FUNCTION_BLOCK
